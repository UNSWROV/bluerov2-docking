<?xml version="1.0"?>
<sdf version="1.11">
  <model name="docking_station">
    <link name="link">
      <!-- gravity must stay disabled on every link: the dock is dynamic (DockSway
           moves it via SetWorldPoseCmd, which fixes pose but not velocity), so
           gravity accumulates velocity and the body free-falls metres between
           pose snaps (measured z jumping -1.8 to -5.25 m). See #58. -->
      <gravity>false</gravity>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://docking_station/meshes/dock_station.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Convex decomposition (Harmonic mesh optimization): DART cannot collide a
           dynamic concave trimesh, and the dock must stay dynamic for DockSway.
           Decomposing the cage into convex hulls at load gives stable contact on a
           dynamic body and never exercises the fragile ODE trimesh-trimesh path.
           max_convex_hulls must stay high enough to preserve the entry cavity. -->
      <collision name="collision">
        <geometry>
          <mesh optimization="convex_decomposition">
            <convex_decomposition>
              <!-- Keep the hull count low: DART's ODE detector treats each hull
                   as a trimesh, so seated contact costs O(hulls x ROV meshes)
                   trimesh pairs per step. 64 hulls overflowed ODE's contact
                   hash and stalled the sim whenever the vehicle rested in the
                   cage. Must stay high enough to keep the entry cavity open. -->
              <max_convex_hulls>16</max_convex_hulls>
            </convex_decomposition>
            <uri>model://docking_station/meshes/dock_station.dae</uri>
          </mesh>
        </geometry>
        <max_contacts>6</max_contacts>
      </collision>
    </link>

    <!-- LED array: 4x green emissive spheres at cage front support corners.
         Model origin: center of dock base, 310mm behind front face, 100mm above base of cage.
         Cage: 750mm wide x 580mm tall, supports 50mm wide.
         Axes (Blender convention): X=horizontal, Y=depth (forward=+Y), Z=up.
         Front face: Y=-0.31m. Corner centres: X=±0.35m, Z=0.025m/0.555m.
         Tune Y if depth axis differs in exported DAE. -->

    <link name="led_top_left">
      <gravity>false</gravity>
      <pose>-0.35 -0.31 0.455 0 0 0</pose>
      <gravity>false</gravity>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 1 0.4 1</ambient>
          <diffuse>0 1 0.4 1</diffuse>
          <emissive>0 1 0.4 1</emissive>
        </material>
      </visual>
    </link>

    <link name="led_top_right">
      <gravity>false</gravity>
      <pose>0.35 -0.31 0.455 0 0 0</pose>
      <gravity>false</gravity>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 1 0.4 1</ambient>
          <diffuse>0 1 0.4 1</diffuse>
          <emissive>0 1 0.4 1</emissive>
        </material>
      </visual>
    </link>

    <link name="led_bottom_left">
      <gravity>false</gravity>
      <pose>-0.35 -0.31 -0.075 0 0 0</pose>
      <gravity>false</gravity>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 1 0.4 1</ambient>
          <diffuse>0 1 0.4 1</diffuse>
          <emissive>0 1 0.4 1</emissive>
        </material>
      </visual>
    </link>

    <link name="led_bottom_right">
      <gravity>false</gravity>
      <pose>0.35 -0.31 -0.075 0 0 0</pose>
      <gravity>false</gravity>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 1 0.4 1</ambient>
          <diffuse>0 1 0.4 1</diffuse>
          <emissive>0 1 0.4 1</emissive>
        </material>
      </visual>
    </link>

    <plugin filename="DockSway" name="dock::DockSway">
      <enabled>true</enabled>
      <!-- rev 2026-07-23: slowed 5s to 18s. At 5s (0.2Hz) the sway outran the
           BlueROV2 + ArduSub tracking bandwidth (measured 240ms plant lag), so the
           vehicle overshot and never velocity-synced for the handoff. 18s (~0.056Hz)
           is quasi-static, within vehicle authority, and more representative of the
           low-frequency swell a moored dock sees at depth. Peak sway velocity drops
           from 0.126 to 0.035 m/s. -->
      <period>18.0</period>
      <heave_amplitude>0.1</heave_amplitude>
      <heave_phase>0.0</heave_phase>
      <sway_amplitude>0.1</sway_amplitude>
      <sway_phase>1.5708</sway_phase>
    </plugin>

    <plugin filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <update_frequency>50</update_frequency>
    </plugin>

  </model>
</sdf>